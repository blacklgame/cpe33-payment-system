rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Roster of students (Nu ID -> name/email/stat).
    // Readable by the app for login lookups. Writable only by a
    // signed-in session -- same anonymous-auth gate as payments below
    // -- so admin-seed.html can write, but random API calls can't.
    // IMPORTANT: after you finish seeding, tighten this back to
    // `allow write: if false;` and republish, so students can't edit
    // their own name/email/stat from the browser console.
    match /users/{nuid} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Payment status + slip metadata, keyed by Nu ID.
    // Readable by the app (Stats page). Writable only by a signed-in
    // session (see firebase.js's anonymous sign-in) -- this blocks
    // anyone from writing directly via the API/console without ever
    // going through your app. It does NOT verify the writer actually
    // owns that Nu ID, since this app has no password login.
    match /payments/{nuid} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
