rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Roster of students (Nu ID -> name/email/stat).
    // Readable by the app for login lookups. Not writable from the
    // client at all -- the roster was loaded once via the Admin SDK
    // (which bypasses rules entirely), so this can stay locked down.
    match /users/{nuid} {
      allow read: if true;
      allow write: if false;
    }

    // Payment status + slip metadata, keyed by Nu ID.
    // Readable by the app (Stats page). Writable only by a signed-in
    // session (see firebase.js's anonymous sign-in) -- this blocks
    // anyone from writing directly via the API/console without ever
    // going through your app. It does NOT verify the writer actually
    // owns that Nu ID, since this app has no password login.
    match /payments/{nuid} {
      allow read: if true;
      allow delete: if false; // Only admins can delete, via Admin SDK

      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(nuid))
        && request.resource.data.keys().hasOnly(['paid', 'fileName', 'slipUrl', 'slipPublicId', 'uploadedAt'])
        && request.resource.data.paid == true
        && request.resource.data.fileName is string
        && request.resource.data.slipUrl is string
        && request.resource.data.slipUrl.matches('^https://res\\.cloudinary\\.com/egcc6hml/image/upload/.+')
        && request.resource.data.slipPublicId is string
        && request.resource.data.slipPublicId.matches('^slips/' + nuid + '/.+')
        && request.resource.data.uploadedAt == request.time;

      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/users/$(nuid))
        && resource.data.get('studentStatus', 'unpaid') != 'termination'
        && request.resource.data.keys().hasOnly(['paid', 'fileName', 'slipUrl', 'slipPublicId', 'uploadedAt', 'studentStatus', 'statusSetBy', 'statusSetAt', 'rejectedBy', 'rejectedAt'])
        // Admin fields must not be modified by the client
        && request.resource.data.get('studentStatus', null) == resource.data.get('studentStatus', null)
        && request.resource.data.get('statusSetBy', null) == resource.data.get('statusSetBy', null)
        && request.resource.data.get('statusSetAt', null) == resource.data.get('statusSetAt', null)
        && request.resource.data.get('rejectedBy', null) == resource.data.get('rejectedBy', null)
        && request.resource.data.get('rejectedAt', null) == resource.data.get('rejectedAt', null)
        // Check student fields if they are updated
        && request.resource.data.paid == true
        && request.resource.data.fileName is string
        && request.resource.data.slipUrl is string
        && request.resource.data.slipUrl.matches('^https://res\\.cloudinary\\.com/egcc6hml/image/upload/.+')
        && request.resource.data.slipPublicId is string
        && request.resource.data.slipPublicId.matches('^slips/' + nuid + '/.+')
        && request.resource.data.uploadedAt == request.time;
    }
  }
}
