rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Default deny all reads and writes across the entire database
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Server-only collections (Client SDK read/write strictly denied; Admin SDK only)
    match /users/{document=**} { allow read, write: if false; }
    match /admins/{document=**} { allow read, write: if false; }
    match /events/{document=**} { allow read, write: if false; }
    match /auditLog/{document=**} { allow read, write: if false; }

    // 3. Owner-only payment records (Authenticated student can only read their own document)
    match /payments/{nuid} {
      allow read: if request.auth != null && request.auth.uid == nuid;
      allow write: if false;

      // Subcollection for per-month payment slip details
      match /months/{monthId} {
        allow read: if request.auth != null && request.auth.uid == nuid;
        allow write: if false;
      }
    }

    // 4. Billing period metadata (Any authenticated user can read active months)
    match /months/{monthId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}

