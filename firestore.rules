rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Roster of students (Nu ID -> name/email/stat).
    // Readable by the app for login lookups. Not writable from the
    // client at all -- the roster was loaded once via the Admin SDK
    // (which bypasses rules entirely), so this can stay locked down.
    match /users/{nuid} {
      allow read: if true;
      allow write: if false;
    }

    // Payment status + slip metadata, keyed by Nu ID.
    // Readable by the app (Stats page). NOT writable from the client
    // at all, from any session (anonymous or otherwise).
    //
    // This used to allow a signed-in client to create/update this
    // doc directly as long as the data "looked right" (regex checks
    // on slipUrl/slipPublicId) -- but a regex only checks the SHAPE
    // of a string, not whether an admin ever reviewed the image. An
    // unsigned Cloudinary upload lets the client choose its own
    // public_id, so anyone could upload an unrelated picture and get
    // back a slipUrl that satisfied every check here, then write
    // paid:true straight into Firestore themselves. That's a
    // complete bypass of payment verification.
    //
    // Every write to this collection now goes through Admin-SDK-only
    // server endpoints that independently verify who's calling and
    // what they're allowed to do:
    //   - api/submit-slip.js       (students: always writes paid:false)
    //   - api/admin/approve-slip.js (admins only: the ONLY path to paid:true)
    //   - api/admin/set-status.js   (admins only)
    //   - api/admin/delete-slip.js  (admins only)
    match /payments/{nuid} {
      allow read: if true;
      allow write: if false;
    }
  }
}
