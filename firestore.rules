rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny for anything not explicitly matched
    match /{document=**} {
      allow read, write: if false;
    }

    // Completely locked down from client (Admin SDK only)
    match /users/{document=**} { allow read, write: if false; }
    match /admins/{document=**} { allow read, write: if false; }
    match /events/{document=**} { allow read, write: if false; }
    match /auditLog/{document=**} { allow read, write: if false; }

    // Owner-only payment data
    match /payments/{nuid} {
      allow read: if request.auth != null && request.auth.uid == nuid;
      allow write: if false;

      // Per-student month detail checks
      match /months/{monthId} {
        allow read: if request.auth != null && request.auth.uid == nuid;
        allow write: if false;
      }
    }

    // Public billing metadata (Authenticated users only)
    match /months/{monthId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
